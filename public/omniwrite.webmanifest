{
  "id": "/apps/omniwrite",
  "name": "Munetios OmniWrite",
  "short_name": "OmniWrite",
  "description": "A powerful and intuitive writing tool by Munetios.",
  "start_url": "/apps/omniwrite",
  "scope": "/apps/omniwrite",
  "display": "standalone",
  "display_override": ["standalone"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "orientation": "any",
  "background_color": "#170524",
  "theme_color": "#3b0764",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/omniwrite-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/omniwrite-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/omniwrite-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/omniwrite-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
