{
  "name": "ganetios",
  "version": "1.0.0",
  "private": true,
  "description": "Ganetios local server with a privacy-preserving favicon proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:account": "node --test account/account-settings.test.cjs",
    "test:auth": "node --test auth/router.test.js",
    "test:collab": "node --test collab/router.test.js",
    "test:youtube": "node --test youtube/router.test.js",
    "test:sheets": "node --test omniwrite/sheets/storage.browser.test.cjs",
    "i18n:validate": "node scripts/validate-locales.cjs",
    "test:webfilter": "node --test webfilter-api/engine.test.js webfilter-api/router.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
